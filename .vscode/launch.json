{
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Launch main.py",
            "program": "${workspaceFolder}/${input:programPath}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "type": "promptString",
            "id": "programPath",
            "description": "Enter the path to the Python file to debug (e.g., main.py)"
        }
    ]
}